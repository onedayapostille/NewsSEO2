# ================================================
# News SEO Analyzer - Environment Configuration
# ================================================

# ================================
# REQUIRED: Database Configuration
# ================================
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ================================
# OPTIONAL: API Configuration
# ================================
# Leave empty for same-origin (production builds)
# Set to http://localhost:3001 for separate dev servers
VITE_API_URL=

# ================================
# OPTIONAL: Server Configuration
# ================================
# Server will use PORT environment variable if available
# Defaults to 3001 if not specified
PORT=3001
NODE_ENV=development

# ================================
# OPTIONAL: Performance Intelligence
# ================================
# Google PageSpeed Insights API
# Optional - works without key but with lower rate limits
# Get key from: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# ================================
# OPTIONAL: Semantic Intelligence
# ================================
# OpenAI API for semantic content analysis
# Required only if you want AI-powered content analysis
# Get key from: https://platform.openai.com/api-keys
# Cost: ~$0.0003 per article (~0.03 cents)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ================================
# OPTIONAL: Google Search Console
# ================================
# For traffic metrics and search performance data
# Setup OAuth 2.0 in Google Cloud Console
# Get credentials from: https://console.cloud.google.com/apis/credentials
GSC_CLIENT_ID=your_client_id.apps.googleusercontent.com
GSC_CLIENT_SECRET=your_client_secret_here

# ================================
# OPTIONAL: Moz API Integration
# ================================
# For Domain Authority, Spam Score, and link metrics
# Requires paid Moz subscription
# Get credentials from: https://moz.com/products/api
MOZ_ACCESS_ID=mozscape-xxxxx
MOZ_SECRET_KEY=your_moz_secret_key_here

# ================================
# Notes
# ================================
# - Only VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are required
# - All other variables are optional and enable additional features
# - The platform works perfectly fine with just the database configured
# - Add integrations as needed through the UI after deployment
