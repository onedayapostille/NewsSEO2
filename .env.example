# ================================================
# News SEO Analyzer - Environment Configuration
# ================================================

# ================================
# REQUIRED: Database Configuration (External Supabase)
# ================================
# Get these from your Supabase project dashboard at https://supabase.com
# Note: Emergent uses MongoDB, but this app requires Supabase.
# You must provide your own Supabase instance credentials.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Alternative names (for flexibility)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ================================
# OPTIONAL: API Configuration
# ================================
# Leave empty for same-origin (production builds)
# Set to http://localhost:8001 for separate dev servers
VITE_API_URL=

# ================================
# Server Configuration
# ================================
# Emergent requires port 8001 for backend
PORT=8001
NODE_ENV=production

# ================================
# OPTIONAL: Feature Integrations
# ================================
# Google Search Console
ENABLE_GSC=false
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=

# Moz API
ENABLE_MOZ=false
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=

# OpenAI
ENABLE_OPENAI=false
OPENAI_API_KEY=
